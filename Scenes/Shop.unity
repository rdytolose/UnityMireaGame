  - clueId: suspicious_man
    prefab: {fileID: 3778992740363421451, guid: c410fa82ecb1feda2bb4504c0e56a2ea, type: 3}
    spawnPoint: {fileID: 1353497976}
  minOrder: 1
  maxOrder: 2
  rewardCorrectServe: 100
  penaltyServeBad: -300
  rewardSkipBad: 100
  penaltySkipGood: -100
  shutter: {fileID: 1570637424}
  shutterOpenPoint: {fileID: 291812430}
  shutterClosedPoint: {fileID: 1820875327}
  shutterMoveDuration: 0.7
  customerMoveDuration: 3
  pauseAfterShutterClose: 0.2
  pauseAfterShutterOpen: 0.3
  pauseBetweenCustomers: 0.8
  dialogText: {fileID: 309432819}
  scoreText: {fileID: 1306460282}
  dialogUI: {fileID: 2074509665}
  portraitCamera: {fileID: 665141541}
  dialogCameraTarget: {fileID: 1719123647}
  playerCameraTransform: {fileID: 330585546}
  scriptsToDisableDuringDialog:
  - {fileID: 1739210960}
  - {fileID: 330585548}
  cameraMoveDuration: 0.7
  feedbackFX: {fileID: 0}
  dialogTemplates:
  - "\u041F\u0440\u0438\u0432\u0435\u0442, \u0445\u043E\u0440\u043E\u0448\u0430\u044F
    \u043D\u043E\u0447\u043A\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F. \u041C\u043D\u0435
    \u043D\u0443\u0436\u043D\u043E {N} \u0431\u0443\u0442\u044B\u043B\u043E\u043A."
  - "\u0417\u0434\u0430\u0440\u043E\u0432\u0430. \u0414\u0430\u0439-\u043A\u0430
    {N} \u0431\u0443\u0442\u044B\u043B\u043E\u043A \u0438 \u043F\u043E\u0439\u0434\u0443."
  - "\u0421\u043B\u044B\u0448\u044C, \u043F\u0440\u043E\u0434\u0430\u0432\u0435\u0446,
    \u043E\u0442\u0441\u044B\u043F\u044C \u043C\u043D\u0435 {N} \u0431\u0443\u0442\u044B\u043B\u043E\u043A."
  - "\u0425\u043E\u043B\u043E\u0434\u043D\u043E, \u0431\u043B\u0438\u043D. \u0427\u0438\u0441\u0442\u043E
    \u0441\u043E\u0433\u0440\u0435\u0442\u044C\u0441\u044F \u2014 {N} \u0431\u0443\u0442\u044B\u043B\u043E\u043A
    \u0434\u0430\u0432\u0430\u0439."
  - "\u041F\u0440\u0438\u0432\u0435\u0442. \u0417\u0430\u043A\u0430\u0437 \u043D\u0430
    {N} \u0431\u0443\u0442\u044B\u043B\u043E\u043A, \u0438 \u043F\u043E\u0431\u044B\u0441\u0442\u0440\u0435\u0435."
  - "\u0417\u0430\u043C\u0451\u0440\u0437 \u044F \u043A\u0430\u043A \u0441\u043E\u0431\u0430\u043A\u0430.
    {N} \u0431\u0443\u0442\u044B\u043B\u043E\u043A \u0431\u0443\u0434\u044C \u0434\u043E\u0431\u0440."
  - "\u0422\u0430\u043A, \u043C\u0443\u0436\u0438\u043A, \u043C\u043D\u0435 {N} \u0431\u0443\u0442\u044B\u043B\u043E\u043A.
    \u041C\u043E\u043B\u0447\u0430."
  - "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435. \u041D\u0435
    \u043F\u043E\u0434\u0441\u043A\u0430\u0436\u0435\u0442\u0435... \u043D\u0443
    \u0432 \u043E\u0431\u0449\u0435\u043C {N} \u0431\u0443\u0442\u044B\u043B\u043E\u043A."
  - "\u0427\u0451 \u0441\u0442\u043E\u0438\u0448\u044C? {N} \u0431\u0443\u0442\u044B\u043B\u043E\u043A
    \u043C\u043D\u0435."
  - "\u0422\u0451\u0437\u043A\u0430, \u0432\u044B\u0440\u0443\u0447\u0430\u0439.
    {N} \u0431\u0443\u0442\u044B\u043B\u043E\u043A \u0438 \u044F \u0438\u0441\u0447\u0435\u0437."
